# Shared local defaults
NODE_ENV=development

# Web runtime
# In production this must point to the public API origin, not localhost.
WEB_PORT=3001
APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# API runtime
API_PORT=4000
API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3001

# Cross-origin auth and proxy policy
# For separate HTTPS web/API origins, set COOKIE_SECURE=true and usually COOKIE_SAMESITE=None.
# COOKIE_DOMAIN should only be set when the final domain strategy is known.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
TRUST_PROXY=false

# API auth secrets
# Replace these in any deployed environment.
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14

# Data services
DATABASE_URL=postgresql://bio_loop:bio_loop_dev@localhost:5453/bio_loop
REDIS_URL=redis://localhost:6379

# API worker/job runtime
JOB_SWEEP_INTERVAL_MS=60000
JOB_INITIAL_DELAY_MS=5000

# Local Docker Postgres bootstrap only
POSTGRES_USER=bio_loop
POSTGRES_PASSWORD=bio_loop_dev
POSTGRES_DB=bio_loop
