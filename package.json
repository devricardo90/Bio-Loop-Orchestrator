{
  "name": "bio-loop-orchestrator",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "24.x",
    "pnpm": "9.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "watch:done": "powershell -ExecutionPolicy Bypass -File tools/watch-done.ps1"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "~5.9.3"
  }
}
