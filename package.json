{
  "name": "bio-loop-orchestrator",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "24.x",
    "pnpm": "9.x"
  },
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File tools/run-with-local-env.ps1 -Command \"turbo run dev\"",
    "dev:api": "powershell -ExecutionPolicy Bypass -File tools/run-with-local-env.ps1 -Command \"pnpm --filter @bio-loop/api dev\"",
    "dev:web": "powershell -ExecutionPolicy Bypass -File tools/run-with-local-env.ps1 -Command \"pnpm --filter @bio-loop/web dev\"",
    "compose:up": "docker compose up -d postgres redis",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f postgres redis",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "watch:done": "powershell -ExecutionPolicy Bypass -File tools/watch-done.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "turbo": "^2.3.3",
    "typescript": "~5.9.3"
  }
}
