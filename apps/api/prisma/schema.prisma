generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SELLER_ADMIN
  SELLER_OPS
  BUYER_ADMIN
  BUYER_OPS
  PLATFORM_ADMIN
}

enum StorageCondition {
  DRY
  COLD
  FROZEN
}

enum LotGrade {
  A
  B
  C
}

enum LotStatus {
  DRAFT
  LISTED
  AWARDED
  PICKUP_SCHEDULED
  PICKED_UP
  COMPLETED
  CANCELLED
  EXPIRED
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  VOID
}

enum OrderStatus {
  CREATED
  CONFIRMED
  IN_DISPUTE
  SETTLED
  CANCELLED
}

enum PickupStatus {
  PENDING
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  CANCELLED
}

enum BuyerApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BuyerApprovalDecision {
  APPROVE
  REJECT
  SUSPEND
  REINSTATE
}

enum BuyerApprovalReason {
  AUTO_APPROVAL
  LOW_REPUTATION
  PAYMENT_RISK
  COMPLIANCE
  MANUAL_REVIEW
}

enum DisputeResolutionDecision {
  SETTLE
  CANCEL_ORDER
  ESCALATE
}

enum InvoiceStatus {
  DRAFT
  READY
  EXPORTED
  SETTLED
  CANCELLED
}

enum FeeType {
  PLATFORM_PERCENT
  PICKUP_FLAT
  DISPUTE_FLAT
  ADJUSTMENT
}

enum ExportFormat {
  CSV
  JSON
}

model User {
  id        String    @id @default(cuid())
  email     String?   @unique
  passwordHash String?
  name      String?
  role      UserRole  @default(SELLER_OPS)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  auditLogs AuditLog[] @relation("AuditLogActor")
  disputesOpened Dispute[] @relation("DisputeOpenedBy")
  disputesResolved Dispute[] @relation("DisputeResolvedBy")
  buyerApprovalsReviewed BuyerApproval[] @relation("BuyerApprovalReviewedBy")
  disputeResolutionsReviewed DisputeResolution[] @relation("DisputeResolutionReviewedBy")
}

model Store {
  id              String   @id @default(cuid())
  externalId      String?  @unique
  name            String
  brandName       String?
  legalEntityName String?
  countryCode     String?  @db.VarChar(2)
  city            String?
  address         String
  postalCode      String?
  timezone        String   @default("Europe/Stockholm")
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  defaultCurrency String?  @db.VarChar(3)
  isActive        Boolean  @default(true)
  contacts        Json
  pickupWindows   Json
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lots Lot[]
}

model Buyer {
  id               String                @id @default(cuid())
  externalId       String?               @unique
  name             String
  buyerType        String?
  city             String?
  approved         Boolean               @default(false)
  radiusKmDefault  Int                   @default(0)
  reputation       Int                   @default(0)
  metadata         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  bids      Bid[]
  orders    Order[]
  approval BuyerApproval?
  interests BuyerCategoryInterest[]
}

model CommodityCategory {
  id               String           @id @default(cuid())
  externalId       String?          @unique
  name             String
  localizedNameSv  String?
  targetIndustry   String?
  storageCondition StorageCondition
  rulesDefault     Json
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lots      Lot[]
  interests BuyerCategoryInterest[]
}

model Lot {
  id                  String          @id @default(cuid())
  externalId          String?         @unique
  storeId            String
  categoryId         String
  storageCondition   StorageCondition
  pickupWindowStartAt DateTime
  pickupWindowEndAt   DateTime
  estimatedWeightKg  Decimal         @db.Decimal(12, 3)
  finalWeightKg      Decimal?        @db.Decimal(12, 3)
  grade              LotGrade
  status             LotStatus       @default(DRAFT)
  sourceExpiresAt    DateTime?
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  store     Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category  CommodityCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  auctions  Auction[]
  order     Order?

  @@index([storeId, status])
  @@index([categoryId, status])
}

model BuyerCategoryInterest {
  id         String   @id @default(cuid())
  buyerId    String
  categoryId String
  createdAt  DateTime @default(now())

  buyer    Buyer             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  category CommodityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([buyerId, categoryId])
  @@index([buyerId])
  @@index([categoryId])
}

model Auction {
  id                   String        @id @default(cuid())
  lotId                String
  startAt              DateTime
  endAt                DateTime
  reservePriceSekPerKg Decimal       @db.Decimal(12, 2)
  status               AuctionStatus @default(SCHEDULED)
  highestBidId         String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  lot        Lot   @relation(fields: [lotId], references: [id], onDelete: Cascade)
  bids       Bid[]
  highestBid Bid?  @relation("AuctionHighestBid", fields: [highestBidId], references: [id], onDelete: SetNull)

  @@index([lotId, status])
}

model Bid {
  id            String   @id @default(cuid())
  auctionId     String
  buyerId       String
  priceSekPerKg Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  buyer   Buyer   @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  auctionAsHighestBid Auction? @relation("AuctionHighestBid")

  @@index([auctionId, createdAt])
  @@index([buyerId, createdAt])
}

model Order {
  id                   String        @id @default(cuid())
  lotId                String        @unique
  buyerId              String
  finalPriceSekPerKg   Decimal       @db.Decimal(12, 2)
  status               OrderStatus   @default(CREATED)
  pickupStatus         PickupStatus  @default(PENDING)
  pickupWindowStartAt  DateTime?
  pickupWindowEndAt    DateTime?
  pickupScheduledAt    DateTime?
  pickupCompletedAt    DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  lot       Lot     @relation(fields: [lotId], references: [id], onDelete: Restrict)
  buyer     Buyer   @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  proofs    PickupProof[]
  dispute   Dispute?
  invoice   Invoice?

  @@index([buyerId, status])
}

model PickupProof {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  url       String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Dispute {
  id               String        @id @default(cuid())
  orderId          String        @unique
  status           DisputeStatus @default(OPEN)
  reason           String?
  openedAt         DateTime      @default(now())
  resolvedAt       DateTime?
  openedByUserId   String?
  resolvedByUserId String?

  order          Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedByUser    User? @relation("DisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)
  resolvedByUser  User? @relation("DisputeResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolution     DisputeResolution?

  @@index([status, openedAt])
}

model BuyerApproval {
  id          String               @id @default(cuid())
  buyerId     String               @unique
  status      BuyerApprovalStatus   @default(PENDING)
  decision    BuyerApprovalDecision?
  reason      BuyerApprovalReason?
  reviewerId  String?
  reviewedAt  DateTime?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  buyer       Buyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  reviewer    User? @relation("BuyerApprovalReviewedBy", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
}

model DisputeResolution {
  id          String                     @id @default(cuid())
  disputeId   String                     @unique
  decision    DisputeResolutionDecision
  note        String?
  reviewerId  String?
  resolvedAt  DateTime                   @default(now())

  dispute     Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  reviewer    User? @relation("DisputeResolutionReviewedBy", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([decision, resolvedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String?
  entityType String
  entityId   String
  action     String
  payload    Json?
  createdAt  DateTime @default(now())

  actorUser User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
}

model Invoice {
  id             String        @id @default(cuid())
  orderId         String        @unique
  sellerId        String
  buyerId         String
  currency        String        @db.VarChar(3)
  status          InvoiceStatus @default(READY)
  billedWeightKg  Decimal       @db.Decimal(12, 3)
  subtotalSek     Decimal       @db.Decimal(12, 2)
  feeTotalSek     Decimal       @db.Decimal(12, 2)
  totalSek        Decimal       @db.Decimal(12, 2)
  issuedAt        DateTime
  exportedAt      DateTime?
  lineItems       Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fees    InvoiceFee[]

  @@index([sellerId, issuedAt])
  @@index([buyerId, issuedAt])
  @@index([status, issuedAt])
}

model InvoiceFee {
  id         String   @id @default(cuid())
  invoiceId   String
  type       FeeType
  label      String
  amountSek  Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, type])
}

model BillingExport {
  id            String       @id @default(cuid())
  format        ExportFormat
  downloadName  String
  fromAt        DateTime
  toAt          DateTime
  invoiceCount  Int
  content       String
  reportSnapshot Json
  createdAt     DateTime     @default(now())

  @@index([createdAt])
  @@index([format, createdAt])
}
