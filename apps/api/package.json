{
  "name": "@bio-loop/api",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node test/run.mjs",
    "db:seed": "powershell -ExecutionPolicy Bypass -File ../../tools/run-with-local-env.ps1 -Command \"pnpm exec prisma migrate deploy --schema prisma/schema.prisma; node prisma/seed.mjs\"",
    "db:import-real:dry-run": "powershell -ExecutionPolicy Bypass -File ../../tools/run-with-local-env.ps1 -Command \"node prisma/import-real-data.mjs\"",
    "db:import-real": "powershell -ExecutionPolicy Bypass -File ../../tools/run-with-local-env.ps1 -Command \"node prisma/import-real-data.mjs --apply\"",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:drift": "node ../../tools/prisma-drift-check.mjs",
    "db:verify-clean": "node ../../tools/db-verify-clean.mjs",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@bio-loop/domain": "workspace:*",
    "@bio-loop/shared": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.16.0",
    "@scalar/nestjs-api-reference": "^1.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@types/node": "^24.1.0",
    "prisma": "^6.16.0"
  }
}
